# Paritok hosted GPU (required — must be accepted by dashboard, not 401)
# https://paritok.com → dashboard → API keys
PARITOK_API_KEY=pk_live_...

# --- Free upstream LLM (pick ONE) ---
#
# Gemini 2.5 Flash (recommended — larger context, better tool use):
#   1. https://aistudio.google.com/apikey → create key
#   2. paste into OPENAI_API_KEY (or GEMINI_API_KEY)
OPENAI_API_KEY=AIza...
RAGMOD_OPENAI_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Prefer lite to save quota. If blocked, try gemini-flash-latest.
RAGMOD_MODEL=gemini-flash-lite-latest
# GEMINI_API_KEY=AIza...   # optional alias if OPENAI_API_KEY is unset

# Groq free alternative (tight TPM — can 413 on large repos):
# OPENAI_API_KEY=gsk_...
# RAGMOD_OPENAI_URL=https://api.groq.com/openai
# RAGMOD_MODEL=llama-3.1-8b-instant
